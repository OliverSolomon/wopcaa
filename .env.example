# Neon Postgres (pooled connection string)
DATABASE_URL=

# Neon Auth (Managed Better Auth). Cookie secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Report encryption. Each key: 32 random bytes, base64. Never change BLIND_INDEX_KEY once reports exist.
DATA_ENCRYPTION_KEYS=k1:
BLIND_INDEX_KEY=

# Neon Object Storage (buckets: media = public_read, evidence = private)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: these emails become super admins on first sign-in (comma separated)
ADMIN_EMAILS=

# Optional: email alerts to admins for new reports (in-app alerts always work)
RESEND_API_KEY=
EMAIL_FROM="WOPCAA <no-reply@wopcaa.org>"
